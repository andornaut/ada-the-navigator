{
  "schema": 1,
  "git": {
    "main": "main",
    "remote": "origin",
    "github": "andornaut/ada-the-navigator"
  },
  "schedule": {
    "departures": ["00"],
    "timezone": "America/Toronto"
  },
  "gate": {
    "image": "sha256:8e211cfb182cd88e2243c38113016c8f22f35de4873e9da58a6685481173a4df",
    "install": "npm ci --maxsockets=1",
    "steps": [
      {
        "name": "lint",
        "run": "tests/container/check lint"
      },
      {
        "name": "test",
        "run": "tests/container/check test"
      },
      {
        "name": "build",
        "run": "tests/container/check build"
      }
    ]
  },
  "resources": {
    "cpus": 4,
    "loadLimit": 20
  },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": {
    "mode": "wrangler"
  },
  "reports": {
    "project": "Ada the Navigator",
    "scheduledTicks": true,
    "recipient": "game-dev",
    "workerParents": ["game-dev"]
  }
}
