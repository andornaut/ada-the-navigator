{
  "schema": 1,
  "git": {
    "main": "main",
    "remote": "origin",
    "github": "andornaut/ada-the-navigator"
  },
  "schedule": {
    "departures": ["00"],
    "timezone": "America/Toronto"
  },
  "gate": {
    "image": "sha256:73513bb781aa550a4b8254c4beea08377de5c1075eccd25fa72472d9a64da68b",
    "install": "npm ci",
    "steps": [
      {
        "name": "lint",
        "run": "tests/container/check lint"
      },
      {
        "name": "test",
        "run": "tests/container/check test"
      },
      {
        "name": "build",
        "run": "tests/container/check build"
      }
    ]
  },
  "resources": {
    "cpus": 4,
    "loadLimit": 30,
    "memoryMiB": 4096
  },
  "ci": {
    "requiredNames": ["AI attributions", "Lint", "Test"],
    "pollSeconds": 60,
    "timeoutSeconds": 1800
  },
  "deploy": {
    "mode": "wrangler",
    "skipPattern": "(\\.md$|^art/|^gameplay/)"
  },
  "reports": {
    "project": "Ada the Navigator",
    "scheduledTicks": true,
    "recipient": "game-coordinator",
    "workerParents": ["game-coordinator"]
  }
}
