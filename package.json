{
  "name": "ada-the-navigator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "npm run internal:hooks && npm run internal:types && npm run lint && npm test && npm run build && npm run deploy:wrangler:dry-run",
    "lint": "npm run internal:lint",
    "format": "prettier --write . && eslint --fix .",
    "test": "vitest run",
    "test:game-kit": "vitest run --configLoader runner src/input/state.test.ts src/loading/loadingBar.test.ts src/pwa/updateOffer.test.ts src/ui/layout/tokens.test.ts",
    "clean": "rm -rf dist .wrangler",
    "prepare": "husky",
    "deploy:wrangler:dry-run": "npm run internal:wrangler",
    "internal:types": "tsc --noEmit",
    "internal:lint": "shellcheck --version && shellcheck -- tests/container/run tests/container/check tests/container/admit && shellcheck --shell=sh -- .husky/pre-commit && prettier --check . && eslint --max-warnings 0 . && markdownlint-cli2",
    "internal:test": "vitest run",
    "internal:worlds": "node tools/test-worlds.mjs",
    "internal:build": "vite build",
    "internal:hooks": "node tools/hooks-smoke.mjs",
    "internal:wrangler": "wrangler deploy --config wrangler.jsonc --no-bundle --dry-run"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.32.0/game-kit-0.32.0.tgz",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.22.0/art-kit-0.22.0.tgz",
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v3.0.1/delivery-kit-3.0.1.tgz",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import-x": {
      "minimatch": "11.0.3"
    },
    "markdown-it": "15.0.3",
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
