{
  "name": "ada-the-navigator",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.2 || ^26.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "./tests/container/check bundle",
    "preview": "npm run build && wrangler dev",
    "check": "./tests/container/check check",
    "lint": "./tests/container/check lint-only",
    "format": "prettier --write . && eslint --fix .",
    "test": "./tests/container/check test",
    "test:game-kit": "vitest run --configLoader runner --no-cache --no-fsModuleCache src/input/state.test.ts src/loading/progress.test.ts src/pwa/updateOffer.test.ts src/tools/phaser-build.test.ts src/ui/layout/tokens.test.ts",
    "typecheck": "./tests/container/check typecheck",
    "clean": "rm -rf dist .wrangler"
  },
  "dependencies": {
    "@andornaut/game-kit": "https://github.com/andornaut/game-kit/releases/download/v0.33.0/game-kit-0.33.0.tgz",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@andornaut/art-kit": "https://github.com/andornaut/art-kit/releases/download/v0.22.0/art-kit-0.22.0.tgz",
    "@andornaut/delivery-kit": "https://github.com/andornaut/delivery-kit/releases/download/v3.0.1/delivery-kit-3.0.1.tgz",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "0.24.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.160.1"
  },
  "overrides": {
    "@eslint/config-array": {
      "minimatch": "11.0.3"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.3"
    },
    "eslint": {
      "minimatch": "11.0.3"
    },
    "eslint-plugin-import-x": {
      "minimatch": "11.0.3"
    },
    "markdown-it": "15.0.3",
    "markdownlint-cli2@0.24.0": {
      "markdownlint": "0.42.1",
      "katex": "0.19.1"
    }
  }
}
