{
  "version": 1,
  "landmarks": {
    "nebula": {
      "layers": [
        {
          "id": "landmark-nebula-outer",
          "tint": "nebulaOuter"
        },
        {
          "id": "landmark-nebula-core",
          "tint": "nebulaCore"
        },
        {
          "id": "landmark-nebula-stars",
          "keyline": "nebulaStars"
        }
      ]
    },
    "wreck": {
      "layers": [
        {
          "id": "landmark-wreck",
          "keyline": "wreck"
        }
      ]
    },
    "beacon": {
      "frames": ["landmark-beacon-a", "landmark-beacon-b"],
