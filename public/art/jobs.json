    "andromeda": {
      "nebulaCore": "#5f647f",
      "nebulaOuter": "#6f7693"
    },
    "cartwheel": {
      "nebulaCore": "#7f645d",
      "nebulaOuter": "#957569"
    },
    "needle": {
      "nebulaCore": "#867c6e",
      "nebulaOuter": "#9e937e"
    },
    "phantom": {
      "nebulaCore": "#907f97",
      "nebulaOuter": "#827388"
    },
    "sunflower": {
      "nebulaCore": "#9d9068",
      "nebulaOuter": "#baab77"
    },
    "whirlpool": {
      "nebulaCore": "#7c908b",
      "nebulaOuter": "#92aba1"
    }
