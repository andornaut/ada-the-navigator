{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ada-the-navigator",
  "account_id": "90f23a78b62eb9571a3fd6c296d15f30",
  "compatibility_date": "2026-11-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "navigator.adabekele.com",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
    },
    "traces": {
      "enabled": true,
    },
  },
}
